# PFIF local deployment configuration.
# Copy to .env, review the values, then run: ./pfif deploy

# Azure identity and region
PFIF_AZURE_SUBSCRIPTION_ID=1fbb027b-5835-4069-a5e2-c60815358d1a
PFIF_AZURE_TENANT_ID=b5d9eb9a-edb1-43df-be5d-87be76aa7dd8
PFIF_AZURE_LOCATION=uaenorth

# Existing OpenTofu remote-state storage
PFIF_STATE_RESOURCE_GROUP=PhotonFiber-Terraform
PFIF_STATE_STORAGE_ACCOUNT=pfterraform6243
PFIF_STATE_CONTAINER=tfstate
PFIF_STATE_KEY=pfif/mailcow-prod.tfstate

# Naming and mail identity
PFIF_PROJECT_NAME=pfif
PFIF_ENVIRONMENT=prod
PFIF_MAIL_DOMAIN=photonfiber.pk
PFIF_MAIL_HOSTNAME=mail.photonfiber.pk
PFIF_TIMEZONE=Asia/Karachi

# VM access
PFIF_ADMIN_USERNAME=azureadmin
PFIF_SSH_PUBLIC_KEY_PATH=~/.ssh/id_ed25519.pub
PFIF_SSH_PRIVATE_KEY_PATH=~/.ssh/id_ed25519
# AUTO discovers your current public IPv4; alternatively use CIDRs separated by commas.
PFIF_SSH_ALLOWED_CIDRS=AUTO

# Cost-conscious defaults suitable for a small Mailcow deployment
PFIF_VM_SIZE=Standard_B2s_v2
PFIF_OS_DISK_SIZE_GB=64
PFIF_DATA_DISK_SIZE_GB=128
PFIF_OS_DISK_TYPE=StandardSSD_LRS
PFIF_DATA_DISK_TYPE=StandardSSD_LRS
# Leave blank unless you explicitly want a zone and confirmed SKU availability.
PFIF_AVAILABILITY_ZONE=
PFIF_ACCELERATED_NETWORKING=false
PFIF_ENCRYPTION_AT_HOST=false

# Dedicated network created by PFIF
PFIF_VNET_ADDRESS_SPACE=10.40.0.0/16
PFIF_SUBNET_ADDRESS_PREFIX=10.40.1.0/24
PFIF_PRIVATE_IP_ADDRESS=10.40.1.10

# Azure Blob backup storage and retention
PFIF_CREATE_BACKUP_STORAGE=true
PFIF_BACKUP_REPLICATION_TYPE=LRS
PFIF_BACKUP_RETENTION_DAYS=14
PFIF_BACKUP_SCHEDULE='*-*-* 02:30:00'

# Mailcow feature switches
PFIF_MAILCOW_SKIP_CLAMD=false
PFIF_MAILCOW_SKIP_FTS=true
PFIF_MAILCOW_SKIP_SOGO=false
PFIF_MAILCOW_ENABLE_IPV6=false
PFIF_MAILCOW_SKIP_LETS_ENCRYPT=false
PFIF_MAILCOW_WATCHDOG_EMAIL=


# Authenticated outbound SMTP relay (recommended on Azure subscriptions that block TCP/25).
# Verify your domain with the relay provider and update SPF/DKIM records as instructed by that provider.
PFIF_SMTP_RELAY_ENABLED=false
PFIF_SMTP_RELAY_HOST=
PFIF_SMTP_RELAY_PORT=587
PFIF_SMTP_RELAY_USERNAME=
PFIF_SMTP_RELAY_PASSWORD=
# starttls is normally used on 587; implicit_tls is normally used on 465.
PFIF_SMTP_RELAY_TLS_MODE=starttls

# Optional Mailcow API. Leave blank to keep it disabled.
PFIF_MAILCOW_API_KEY=
PFIF_MAILCOW_API_ALLOW_FROM=127.0.0.1,172.22.1.1

# Optional Cloudflare DNS automation.
# Token requires Zone:DNS:Edit on photonfiber.pk and is read only from this local .env.
PFIF_MANAGE_CLOUDFLARE_DNS=false
PFIF_CLOUDFLARE_ZONE_ID=AUTO
PFIF_CLOUDFLARE_API_TOKEN=

# Reverse DNS. Azure validates that this FQDN resolves to the VM public IP.
PFIF_CONFIGURE_REVERSE_DNS=true
